# Fonte dos dados: "tse" (oficial) ou "mock" (simulação com candidatos fictícios)
TSE_SOURCE=tse

# Endereço dos arquivos de divulgação do TSE (padrão 2026: {base}/{ciclo}/{eleicao}/dados/{uf}/{uf}-c{cargo}-e{eleicao}-u.json)
TSE_BASE_URL=https://resultados.tse.jus.br/oficial
TSE_CYCLE=ele2026
TSE_DATA_PATH=dados
TSE_FILE_SUFFIX=u

# Códigos das eleições (vazio = padrão 2026)
# Federal (Presidente): 6257 no 1º turno, 6258 no 2º turno
# Estadual (Governador, Senador, Deputados): 6259 no 1º turno, 6260 no 2º turno
TSE_ELECTION_FEDERAL=
TSE_ELECTION_STATE=
TSE_ELECTION_FEDERAL_R2=
TSE_ELECTION_STATE_R2=

# Turno acompanhado (1 ou 2)
TSE_ROUND=1

# Intervalo entre ciclos de consulta, concorrência e timeout (respeite os limites técnicos do TSE)
POLL_INTERVAL_MS=30000
POLL_CONCURRENCY=4
TSE_TIMEOUT_MS=10000

# Cargos acompanhados (vazio = todos): presidente,governador,senador,deputado-federal,deputado-estadual,deputado-distrital
TRACK_OFFICES=

# Onde ficam arquivos originais, snapshots e auditoria
DATA_DIR=data
ARCHIVE_RAW=true

# Duração da apuração simulada (apenas TSE_SOURCE=mock)
MOCK_DURATION_MIN=30

# Candidatos fixados no topo das páginas: cargo:uf:nome-de-urna (ou #numero), separados por ";"
# Padrão: Robertinho da Padaria, Eduardo Cury, Eduardo Sivinsk e Dr. Elton (Dep. Federal SP); Leticia Aguiar e Thomaz Henrique (Dep. Estadual SP). Deixe vazio (FEATURED_CANDIDATES=) para não fixar ninguém.
FEATURED_CANDIDATES=deputado-federal:sp:ROBERTINHO DA PADARIA;deputado-federal:sp:EDUARDO CURY;deputado-federal:sp:EDUARDO SIVINSK;deputado-federal:sp:DR ELTON;deputado-estadual:sp:LETICIA AGUIAR;deputado-estadual:sp:THOMAZ HENRIQUE

# Mapa municipal: UFs com desenho em apps/web/public/maps e intervalo de consulta
MUNICIPAL_UFS=sp
MUNICIPAL_POLL_MS=60000
