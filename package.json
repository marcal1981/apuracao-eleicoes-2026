{
  "name": "apuracao-eleicoes-2026",
  "private": true,
  "description": "Plataforma independente de acompanhamento da apuração das Eleições 2026 a partir de dados oficiais do TSE",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev -w @apuracao/web",
    "dev:mock": "TSE_SOURCE=mock npm run dev -w @apuracao/web",
    "build": "npm run build -w @apuracao/web",
    "start": "npm run start -w @apuracao/web",
    "test": "npm run test -w @apuracao/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
